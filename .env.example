# =============================================================================
# Self-Healing Agent — environment variables
# Copy this file to `.env` and fill in the blanks after `cdk deploy`.
# Never commit `.env` (it's in .gitignore).
# =============================================================================

# --- AWS region (Mumbai) ---
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# --- S3 buckets (filled in by CDK output after `cdk deploy`) ---
# Run: aws cloudformation describe-stacks --stack-name SelfHealingAgentStack \
#        --query "Stacks[0].Outputs"
INPUT_BUCKET=
OUTPUT_BUCKET=
STATE_BUCKET=

# --- Bedrock model used for summarization ---
# Claude 3.5 Haiku — confirmed available in ap-south-1.
# If Claude Haiku 4.5 is enabled in your account, you can swap to:
#   anthropic.claude-haiku-4-5-20251001-v1:0   # UNVERIFIED — confirm in console first
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# --- AgentCore (filled in by deploy script) ---
AGENT_RUNTIME_ARN=
AGENT_MEMORY_ID=

# --- Local state fallback (used outside AgentCore Runtime) ---
# When running tests / local dev, checkpoints land in this directory
# instead of AgentCore Memory.
STATE_DIR=./state

# --- Demo configuration ---
DEMO_TASK_ID=task-001
DEMO_PDF_COUNT=100
ARXIV_QUERY=cat:cs.AI

# --- Logging ---
LOG_LEVEL=INFO
